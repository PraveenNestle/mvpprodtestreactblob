# ---- Runtime
PORT=8080
LOCAL_MODE=false                 # true = in-memory store + bundled demo reference data + header-based demo identity (no Azure needed)
STATIC_DIR=../../frontend/dist   # serve the built React app from the same Web App (leave empty when hosted separately)
ALLOWED_ORIGINS=https://stability.nhsc.example.com

# ---- Microsoft Entra ID (R-29). Roles come from app roles: Stability.Scientist, Stability.Reviewer, Stability.Admin
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_AUDIENCE=api://stability-capture-api      # Application ID URI of the API app registration

# ---- Azure Blob Storage: the only data store (R-22, R-23, R-35). Managed identity in Azure; connection string only for local dev.
STORAGE_ACCOUNT_NAME=stsdctprod
STORAGE_CONNECTION_STRING=
CONTAINER_REFERENCE=reference      # NESTMS / LIMS exports: projects, ARs, trials, variants, samples, plans, lab results, users
CONTAINER_OBSERVATIONS=observations
CONTAINER_MEDIA=media
CONTAINER_CURATED=curated
CONTAINER_CONFIG=config
SAS_UPLOAD_MINUTES=15
